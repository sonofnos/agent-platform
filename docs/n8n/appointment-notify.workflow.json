{
  "name": "Notify on new appointment booking",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-booked",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1f7a2b3c-0000-4000-8000-000000000001",
      "name": "Webhook: appointment booked",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "8f2a1c3d-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.status }}",
              "rightValue": "confirmed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "8f2a1c3d-0000-4000-8000-000000000002",
      "name": "If confirmed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": \"New appointment booked: \" + $json.appointmentId + \" for patient \" + $json.patientRef } }}",
        "options": {}
      },
      "id": "3c4d5e6f-0000-4000-8000-000000000003",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_PLATFORM_BASE_URL }}/api/webhooks/voice",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-tenant-id", "value": "={{ $json.tenantId }}" },
            { "name": "x-timestamp", "value": "={{ $json.timestamp }}" },
            { "name": "x-signature", "value": "={{ $json.signature }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ eventId: $json.eventId }) }}",
        "options": {}
      },
      "id": "5e6f7a8b-0000-4000-8000-000000000004",
      "name": "Acknowledge to agent-platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 380]
    }
  ],
  "connections": {
    "Webhook: appointment booked": {
      "main": [[{ "node": "If confirmed", "type": "main", "index": 0 }]]
    },
    "If confirmed": {
      "main": [
        [{ "node": "Notify Slack", "type": "main", "index": 0 }],
        [{ "node": "Acknowledge to agent-platform", "type": "main", "index": 0 }]
      ]
    }
  }
}
