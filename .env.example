PORT=8080
DATABASE_URL=postgres://agent_platform:agent_platform@localhost:5442/agent_platform
VOICE_WEBHOOK_SECRET=dev-webhook-secret

# Leave these unset to run fully offline (FakeLlmClient / FakeEmbeddingClient).
# Set them to any OpenAI-compatible endpoint -- OpenAI, Groq, or a LiteLLM proxy -- to go live.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=768
